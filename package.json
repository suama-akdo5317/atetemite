{
  "name": "atetemite",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "batch": "bun run batch/generate.ts",
    "test:int": "vitest run --project int",
    "env:local": "supabase status -o env | awk -F= '/^API_URL=/{print \"VITE_SUPABASE_URL=\"$2; print \"SUPABASE_URL=\"$2} /^PUBLISHABLE_KEY=/{print \"VITE_SUPABASE_PUBLISHABLE_KEY=\"$2} /^SECRET_KEY=/{print \"SUPABASE_SECRET_KEY=\"$2}' > .env.local",
    "db:types": "supabase gen types typescript --local > shared/database.types.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "dev:phone": "VITE_SUPABASE_URL=/supabase vite --port 5175 --strictPort"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
